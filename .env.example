# Copy to .env and fill in. Run commands with `uv run --env-file .env ...`.

# DuckLake catalog: a Postgres database, for example a free Supabase project.
# Use Supabase's session pooler: the direct connection is IPv6 only, which GitHub Actions can't reach.
CATALOG_HOST=aws-0-<region>.pooler.supabase.com
CATALOG_PORT=5432
CATALOG_DB=postgres
CATALOG_USER=postgres.<project-ref>
CATALOG_PASSWORD=<database-password>

# DuckLake data: Parquet files in a Cloudflare R2 bucket, with an API token scoped to that bucket.
# The data path (bucket plus prefix) is stored in the catalog, so don't change it after the first load.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_KEY_ID=<r2-access-key-id>
R2_SECRET=<r2-secret-access-key>
R2_BUCKET=lake
R2_PREFIX=mallard/
